<%- include('partials/head') %>
<main class="auth-page">
  <section class="panel auth-panel">
    <p class="eyebrow">Вход</p>
    <h1><%= role === 'trainer' ? 'Кабинет тренера-продавца' : role === 'admin' ? 'Админка маркетплейса' : 'Кабинет покупателя' %></h1>
    <p class="muted-text">Демо-пароль для всех ролей: <strong>password123</strong></p>
    <form class="stack-form" action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email
        <input name="email" type="email" required value="<%= role === 'trainer' ? 'trainer@sportshopfitness.local' : role === 'admin' ? 'admin@sportshopfitness.local' : 'client@sportshopfitness.local' %>">
      </label>
      <label>Пароль
        <input name="password" type="password" required value="password123">
      </label>
      <button class="btn primary" type="submit">Войти</button>
    </form>
  </section>

  <section class="panel auth-panel">
    <p class="eyebrow">Регистрация</p>
    <h1>Подключиться к маркетплейсу</h1>
    <form class="stack-form" action="/register" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Роль
        <select name="role">
          <option value="client" <%= role !== 'trainer' ? 'selected' : '' %>>Покупатель</option>
          <option value="trainer" <%= role === 'trainer' ? 'selected' : '' %>>Тренер-продавец</option>
        </select>
      </label>
      <label>Имя
        <input name="full_name" required placeholder="Например, Самат Султанов">
      </label>
      <label>Email
        <input name="email" type="email" required placeholder="you@example.com">
      </label>
      <label>Пароль
        <input name="password" type="password" required placeholder="Минимум 6 символов">
      </label>
      <div class="form-row">
        <label>Телефон
          <input name="phone" placeholder="+7">
        </label>
        <label>Город
          <input name="city" placeholder="Алматы">
        </label>
      </div>
      <label>Специализация для тренера
        <input name="specialization" placeholder="Фитнес, питание, реабилитация">
      </label>
      <button class="btn primary" type="submit">Зарегистрироваться</button>
    </form>
  </section>
</main>
<%- include('partials/end') %>
