<%- include('../partials/head') %>
<main class="app-shell">
  <%- include('../partials/client_nav') %>
  <section class="workspace">
    <div class="page-head"><div><p class="eyebrow">История</p><h1>Оплаты</h1></div></div>
    <section class="panel">
      <div class="table-wrap"><table><thead><tr><th>Дата</th><th>Сумма</th><th>Метод</th><th>Комментарий</th></tr></thead><tbody>
        <% payments.forEach(pay => { %><tr><td><%= pay.payment_date %></td><td><%= money(pay.amount) %></td><td><%= pay.payment_method %></td><td><%= pay.comment %></td></tr><% }) %>
      </tbody></table></div>
    </section>
  </section>
</main>
<%- include('../partials/end') %>
