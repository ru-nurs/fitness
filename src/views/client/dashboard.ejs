<%- include('../partials/head') %>
<main class="workspace standalone">
  <div class="page-head">
    <div>
      <p class="eyebrow">Кабинет покупателя</p>
      <h1>Покупки, подписки и материалы</h1>
    </div>
    <a class="btn primary" href="/catalog">Продолжить покупки</a>
  </div>

  <section class="stats">
    <article><span>Заказы</span><strong><%= orders.length %></strong><p>Курсы, услуги и товары</p></article>
    <article><span>Оплачено</span><strong><%= money(orders.reduce((sum, order) => sum + order.amount, 0)) %></strong><p>В демо-заказах</p></article>
    <article><span>Подписка</span><strong>Base</strong><p>Можно повысить до Pro Trainer</p></article>
    <article><span>Материалы</span><strong><%= orders.filter(order => order.product && order.product.type !== 'physical').length %></strong><p>Доступны после оплаты</p></article>
  </section>

  <section class="grid two">
    <div class="panel">
      <h2>История заказов</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Заказ</th><th>Позиция</th><th>Продавец</th><th>Сумма</th><th>Статус</th></tr></thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr>
                <td><%= order.id %><br><small><%= formatDate(order.created_at) %></small></td>
                <td><%= order.product?.title || 'Товар удален' %></td>
                <td><%= order.sellerProfile?.full_name || 'SportShopFitness' %></td>
                <td><%= money(order.amount) %></td>
                <td><span class="pill"><%= order.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <h2>Тарифы подписки</h2>
      <div class="compact-list">
        <% subscriptions.forEach(plan => { %>
          <span>
            <span><strong><%= plan.name %></strong><small><%= plan.access %></small></span>
            <em><%= money(plan.price_month) %>/мес</em>
          </span>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Рекомендации маркетплейса</h2>
    <div class="product-grid mini">
      <% recommendations.forEach(product => { %>
        <article class="product-card">
          <a href="/products/<%= product.id %>">
            <img src="<%= product.image_url %>" alt="<%= product.title %>">
            <div class="product-body">
              <h3><%= product.title %></h3>
              <div class="product-meta"><strong><%= money(product.price) %></strong><small><%= product.category %></small></div>
            </div>
          </a>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<%- include('../partials/end') %>
